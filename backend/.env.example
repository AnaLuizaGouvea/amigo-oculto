# Chave longa e aleatória criada por você. Não compartilhe nem coloque no HTML.
ADMIN_KEY=troque-por-uma-chave-longa-e-aleatoria

# Dados da aplicação Meta / WhatsApp Cloud API
META_ACCESS_TOKEN=COLOQUE_SEU_TOKEN_DA_META
META_PHONE_NUMBER_ID=COLOQUE_SEU_PHONE_NUMBER_ID

# Nome e idioma exatos do modelo aprovado no WhatsApp Manager
WHATSAPP_TEMPLATE_NAME=amigo_oculto_resultado
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Graph API version habilitada para seu app Meta (ajuste se necessário)
META_GRAPH_VERSION=v23.0

# Origem exata do GitHub Pages, sem barra no final
ALLOWED_ORIGIN=https://SEU-USUARIO.github.io
